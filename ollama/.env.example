# Cloudflare Tunnel token (create one in Zero Trust dashboard).
# Required only when running with `--profile prod`.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_AUTO_UPDATE=true

# Bearer token used by clients when the Ollama endpoint is protected.
OLLAMA_SECRET_API_KEY=

# Public/proxy endpoint used by deployed clients.
OLLAMA_BASE_URL=https://ai.caloriesguard.com

# Which model to pre-pull on container start.
OLLAMA_PRELOAD_MODEL=deepseek-r1:8b

# How long to keep a loaded model in RAM/VRAM after the last request.
OLLAMA_KEEP_ALIVE=24h

# Concurrent requests handled in parallel (each parallel slot reserves
# its own KV-cache, so raise this only if you have spare VRAM).
OLLAMA_NUM_PARALLEL=2
