# ── n8n UI access ────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# ── n8n public URL (ถ้าเปิด tunnel ให้ใส่ domain จริง) ──────────────────────
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678

# ── CaloriesGuard backend ─────────────────────────────────────────────────────
# local dev: http://host.docker.internal:8000
# prod:      https://api.caloriesguard.com
CALORIESGUARD_API_URL=http://host.docker.internal:8000

# ── Notification channels (ใส่อย่างน้อย 1 อัน) ──────────────────────────────
# Slack: สร้าง Incoming Webhook ที่ api.slack.com/apps
SLACK_WEBHOOK_URL=

# Line Notify: https://notify-bot.line.me/th/
LINE_NOTIFY_TOKEN=
