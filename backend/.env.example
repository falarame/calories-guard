# ── Database ───────────────────────────────────────────────────────────────
DB_MODE=local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=caloriesguard
DB_USER=caloriesguard
DB_PASSWORD=

# ── Supabase (auth + storage) ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# ── CORS ───────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── AI / LLM ───────────────────────────────────────────────────────────────
# We use a self-hosted Ollama daemon. See ollama/README.md for the Docker
# stack. No external LLM API keys are involved.

# Local dev (Ollama on the same machine)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Production (Ollama exposed via Cloudflare Tunnel)
# OLLAMA_BASE_URL=https://ai.caloriesguard.com

OLLAMA_MODEL=deepseek-r1:1.5b
OLLAMA_TIMEOUT=60
OLLAMA_NUM_PREDICT=320

# Optional auth — pick ONE if the tunnel/proxy protects Ollama:
#   (a) generic bearer token. Keep this name aligned with the legacy docker proxy.
OLLAMA_SECRET_API_KEY=
#   (b) Cloudflare Access service token pair
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Kill switch: AI_ENABLED=false makes /api/chat/* return 503 without redeploy.
AI_ENABLED=true

# ── Email (optional) ──────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=Calories Guard

# ── Observability (optional) ──────────────────────────────────────────────
SENTRY_DSN=
APP_ENV=development
